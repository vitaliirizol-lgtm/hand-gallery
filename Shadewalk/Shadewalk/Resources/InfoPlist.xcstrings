    "NSLocationWhenInUseUsageDescription" : {
      "comment" : "Privacy - Location When In Use Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shadewalk uses your location to start shady walking routes from where you are and to guide you along them."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shadewalk использует вашу геопозицию, чтобы начинать тенистые пешие маршруты там, где вы находитесь, и вести вас по ним."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shadewalk використовує вашу геолокацію, щоб починати тінисті пішохідні маршрути там, де ви перебуваєте, і вести вас ними."
          }
        }
      }
    }
  },
  "version" : "1.0"
