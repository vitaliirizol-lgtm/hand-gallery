    "Arcades, colonnades, tunnels and indoor passages always count as shade." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Аркады, колоннады, тоннели и крытые проходы всегда считаются тенью."
