        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Це задалеко (%1$@): пішохідні маршрути — не довші за %2$@."
          }
        }
      }
    },
    "The destination is too far from any footpath." : {
      "comment" : "Route planning error.",
