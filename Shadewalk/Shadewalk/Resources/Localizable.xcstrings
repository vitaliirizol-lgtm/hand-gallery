            "state" : "translated",
            "value" : "Звідки"
          }
        }
      }
    },
    "From %@ to %@. Sun on the left side %@ of the time, on the right side %@, ahead or behind %@, below the horizon %@." : {
      "comment" : "VoiceOver summary of the seat-side timeline. Times, then four percentages.",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "С %1$@ до %2$@. Солнце слева %3$@ времени, справа %4$@, спереди или сзади %5$@, за горизонтом %6$@."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "З %1$@ до %2$@. Сонце ліворуч %3$@ часу, праворуч %4$@, спереду чи позаду %5$@, за обрієм %6$@."
