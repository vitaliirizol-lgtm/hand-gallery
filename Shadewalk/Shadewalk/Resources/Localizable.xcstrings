    "Automatic units follow your iPhone’s region. The shade overlay setting applies the next time Shadewalk starts." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Автоматические единицы зависят от региона iPhone. Настройка слоя теней применится при следующем запуске Shadewalk."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Автоматичні одиниці залежать від регіону iPhone. Налаштування шару тіней застосується під час наступного запуску Shadewalk."
          }
        }
      }
    },
    "Avoid stairs" : {
