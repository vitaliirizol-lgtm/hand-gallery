        }
      }
    },
    "Allow location" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разрешить доступ к геопозиции"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дозволити доступ до геолокації"
          }
        }
      }
    },
    "Allow location so routes start where you are and you can follow along as you walk." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разрешите доступ к геопозиции, чтобы маршруты начинались там, где вы находитесь, а навигация вела вас по пути."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дозвольте доступ до геолокації, щоб маршрути починалися там, де ви перебуваєте, а навігація вела вас дорогою."
          }
        }
      }
    },
    "Allow location so routes start where you are and you can follow along as you walk. It’s only used to plan and guide your walks." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разрешите доступ к геопозиции, чтобы маршруты начинались там, где вы находитесь, а навигация вела вас по пути. Геопозиция нужна только для построения маршрутов и навигации."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дозвольте доступ до геолокації, щоб маршрути починалися там, де ви перебуваєте, а навігація вела вас дорогою. Геолокація потрібна лише для прокладання маршрутів і навігації."
          }
        }
      }
    },
    "Also balanced" : {
